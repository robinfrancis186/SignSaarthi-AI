{
  "name": "signsaarthi-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @signsaarthi/api --filter @signsaarthi/extension start",
    "dev": "pnpm --parallel --filter @signsaarthi/api --filter @signsaarthi/extension dev",
    "dev:api": "pnpm --filter @signsaarthi/api dev",
    "dev:extension": "pnpm --filter @signsaarthi/extension dev",
    "graph:build": "graphify extract . --code-only && graphify cluster-only . --no-label",
    "graph:query": "graphify query",
    "graph:update": "graphify update . && graphify cluster-only . --no-label",
    "dataset:include:metadata": "tsx --tsconfig tsconfig.scripts.json scripts/fetch-include-metadata.ts",
    "dataset:include:all-metadata": "SIGNSAARTHI_INCLUDE_SPLITS=train,val,test SIGNSAARTHI_INCLUDE_LIMIT=all tsx --tsconfig tsconfig.scripts.json scripts/fetch-include-metadata.ts data/isl/include-metadata.json",
    "dataset:include:videos:dry-run": "SIGNSAARTHI_DRY_RUN=true tsx --tsconfig tsconfig.scripts.json scripts/download-include-videos.ts",
    "dataset:include:videos": "SIGNSAARTHI_DRY_RUN=false tsx --tsconfig tsconfig.scripts.json scripts/download-include-videos.ts",
    "dataset:include:archive-metadata": "tsx --tsconfig tsconfig.scripts.json scripts/prepare-include-archive-metadata.ts",
    "dataset:include:smoke-subset": "tsx --tsconfig tsconfig.scripts.json scripts/prepare-include-smoke-subset.ts",
    "dataset:unified:bootstrap": "python3 scripts/build_unified_isl_dataset.py build --output-dir output/huggingface/Robin186-ISL --lexicon data/isl/bootstrap-lexicon.json --motion-catalog data/models/isl-motion-catalog.json --min-official-entries 10000 --overwrite",
    "dataset:unified:build": "python3 scripts/build_unified_isl_dataset.py build --output-dir output/huggingface/Robin186-ISL --lexicon data/models/isl-lexicon-model.json --motion-catalog data/models/isl-motion-catalog.json --min-official-entries 10000 --overwrite",
    "dataset:unified:validate": "python3 scripts/build_unified_isl_dataset.py validate --bundle-dir output/huggingface/Robin186-ISL",
    "dataset:training:build": "python3 scripts/build_signsaarthi_training_dataset.py build --overwrite",
    "dataset:training:validate": "python3 scripts/build_signsaarthi_training_dataset.py validate",
    "dataset:alphabet:build": ".venv-mediapipe/bin/python scripts/build-islrtc-alphabet-motion.py --source-video /tmp/signsaarthi-alphabet/alphabet.mp4",
    "dataset:include:motion-library": ".venv-mediapipe/bin/python scripts/extract_include_motion_library.py",
    "dataset:include:all-motions": ".venv-mediapipe/bin/python scripts/extract_include_motion_library.py --all-labels --workers 3 --checkpoint data/isl/include-motion-extraction-v2.json",
    "dataset:isign:plan": ".venv-mediapipe/bin/python scripts/build_isign_research_corpus.py plan-sentences --samples 10020",
    "dataset:isign:word-motions": ".venv-mediapipe/bin/python scripts/build_isign_research_corpus.py extract-words --accept-research-only-terms --max-bytes 2GiB --workers 6",
    "dataset:isign:sentences": ".venv-mediapipe/bin/python scripts/build_isign_research_corpus.py extract-sentences --accept-research-only-terms --max-bytes 20GiB --workers 6",
    "dataset:isign:validate": ".venv-mediapipe/bin/python scripts/validate_isign_research_corpus.py --accept-research-only-terms",
    "keypoints:include:extract": "tsx --tsconfig tsconfig.scripts.json scripts/extract-include-keypoints.ts",
    "keypoints:combine": "tsx --tsconfig tsconfig.scripts.json scripts/combine-keypoint-datasets.ts",
    "lint": "pnpm -r lint",
    "model:lexicon:compile": "python3 scripts/compile_unified_isl_lexicon.py",
    "model:text-matcher:train": "python3 scripts/train_isl_text_matcher.py --verify-determinism",
    "model:isign:train:private": "python3 scripts/train_isign_sentence_planner.py --verify-determinism",
    "model:isign:text-to-pose:private": ".venv-isign-training/bin/python scripts/train_isign_text_to_pose.py --validation-report data/private/isign-research/validation-report.private.json --accept-research-only-terms",
    "model:isign:text-to-pose:preview": ".venv-isign-training/bin/python scripts/preview_isign_text_to_pose.py --text \"Artificial intelligence can improve accessible education in India.\" --accept-research-only-terms",
    "model:train": "pnpm model:lexicon:compile",
    "package:release": "tsx --tsconfig tsconfig.scripts.json scripts/package-local-release.ts",
    "playwright:install": "playwright install chromium",
    "release:local": "pnpm build && pnpm package:release",
    "scripts:typecheck": "tsc -p tsconfig.scripts.json --noEmit",
    "smoke:extension": "tsx --tsconfig tsconfig.scripts.json scripts/smoke-extension.ts",
    "smoke:youtube-live": "SIGNSAARTHI_REAL_YOUTUBE=true SIGNSAARTHI_E2E_HEADED=true tsx --tsconfig tsconfig.scripts.json scripts/smoke-extension.ts",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "tsx --tsconfig tsconfig.scripts.json scripts/verify-loop.ts",
    "verify:ml": "pnpm --filter @signsaarthi/isl-model verify:release",
    "verify:loop": "tsx --tsconfig tsconfig.scripts.json scripts/verify-loop.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^26.1.0",
    "eslint": "^9.31.0",
    "fflate": "0.8.2",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "packageManager": "pnpm@11.7.0"
}
